<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Demo/geliştirme sırasında sunucu genellikle aynı Wi-Fi ağındaki bir
         dizüstünde çalışır ve LAN adresi önceden bilinemez. Debug derlemesi
         bu yüzden şifresiz HTTP'ye izin veren gevşek yapılandırmayı kullanır.
         Release derlemesi src/main içindeki sıkı yapılandırmada kalır. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig" />
</manifest>
