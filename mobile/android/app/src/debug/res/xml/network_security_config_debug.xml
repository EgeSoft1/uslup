<?xml version="1.0" encoding="utf-8"?>
<!--
  YALNIZCA DEBUG derlemeleri için.

  Demo sırasında sunucu çoğu zaman geliştiricinin dizüstünde, telefon da
  aynı Wi-Fi ağındadır. O makinenin LAN adresi (192.168.x.x gibi) önceden
  bilinemez ve Android ağ güvenliği yapılandırması CIDR aralığı kabul
  etmez — her adresi tek tek yazmak gerekirdi.

  Bu yüzden debug derlemesinde şifresiz HTTP serbesttir. Release derlemesi
  `src/main/res/xml/network_security_config.xml` kullanmaya devam eder ve
  orada yalnızca yerel geri döngü adresleri açıktır.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
