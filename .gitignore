mobile/linux/flutter/ephemeral/
mobile/macos/Flutter/ephemeral/
mobile/windows/flutter/ephemeral/

# ── Saf Dart paketleri (packages/, server/) ───────────────────────────────────
# pubspec.lock uygulamalar için DEPOYA GİRER (yeniden üretilebilir derleme),
# kütüphaneler için girmez.
.dart_tool/
packages/*/pubspec.lock
server/.dart_tool/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
.DS_Store

# ── Gizli bilgiler — ASLA depoya girmemeli ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
secrets/
# Sunucu erişim betikleri — içlerinde düz metin root şifresi var.
# Depo herkese açık; bu dosyalar hiçbir koşulda commit edilmemeli.
deploy_to_vds.py
vds_monitor.py

# ── Model yapıtları (büyük ikili dosyalar) ────────────────────────────────────
# ONNX modelleri Git LFS ile veya sürüm eklerinde dağıtılır, depoda tutulmaz.
*.onnx
*.pt
*.bin
!**/vocab.txt

# ml/ üretilen çıktılar (01_veri_cikar.py yeniden üretir)
ml/*.json

# Sunum ekran görüntüleri — `flutter test tool/ekran_goruntusu_test.dart`
# her seferinde yeniden üretir; ~15 MB ikili dosyayı depoya koymaya gerek yok.
docs/gorseller/ekranlar/

# Python önbelleği (görsel üretim betikleri)
__pycache__/
*.pyc

# Geçici hata ayıklama betikleri — alt çizgiyle başlayanlar tek seferliktir,
# depoya girmez (ölçüm okuyucuları, jüri prova betikleri vb.)
packages/*/bin/_*.dart

# Motorun JavaScript derlemesi — `dart compile js` her seferinde yeniden üretir
# (README · Bir platforma nasıl eklenir).
packages/civility_core/example/web/uslup.js
packages/civility_core/example/web/uslup.js.*
